# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Model checkpoints & weights -- these get regenerated by train.py and can
# be hundreds of MB (full fine-tune) -- never commit them
checkpoints/
*.pt
*.pth
*.bin
*.safetensors

# Hugging Face / datasets local cache (if run outside Colab)
.cache/
*.lock

# Jupyter
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: results.csv, accuracy_vs_rank.png, and memory_vs_rank.png are
# intentionally NOT ignored -- those are the actual deliverables and
# should be committed once you've generated them.
